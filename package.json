{
  "name": "wemakedevs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "vite",
    "api": "node --env-file-if-exists=.env.local server/localApi.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test \"backend/test/*.test.js\"",
    "aws:build": "sam build",
    "aws:deploy": "sam deploy --guided",
    "aws:env": "node scripts/pull-stack-env.mjs",
    "aws:deploy-frontend": "node scripts/deploy-frontend.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
