# HeatGuard local configuration. Copy to .env.local (git-ignored) and adjust.
# `npm run aws:env` fills in the stack values below automatically after `sam deploy`.

# --- AWS credentials come from your normal AWS setup (aws configure / AWS_PROFILE / SSO) ---
# AWS_PROFILE=default
AWS_REGION=us-east-1

# --- Deployed stack resources (leave empty to use in-memory / in-process stand-ins) ---
HEATGUARD_TABLE_NAME=
HEATGUARD_EVENT_BUS_NAME=
HEATGUARD_BROADCAST_TOPIC_ARN=
HEATGUARD_ALERTS_TOPIC_ARN=

# --- Amazon Bedrock ---
# auto = use Bedrock whenever AWS credentials resolve; local = always use the Calibrated Local Engine
HEATGUARD_AI_MODE=auto
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5-5
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-sonnet-5
# BEDROCK_REGION=us-east-1
# BEDROCK_EFFORT=low          # low | medium | high | none

# --- Frontend ---
# Point the UI at a deployed API Gateway instead of the local handlers:
# VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
# Disable the local /api middleware entirely (simulates static hosting / browser-only mode):
# HEATGUARD_LOCAL_API=off
